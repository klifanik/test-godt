[sub_resource type="Shader" id="Shader_q712h"]
code = "shader_type canvas_item;

void fragment() {
    // Находим центр текстуры (0.5, 0.5)
    vec2 center = vec2(0.5, 0.5);
    
    // Считаем расстояние от текущего пикселя до центра
    float dist = distance(UV, center);
    
    // Получаем исходный цвет пикселя из нашей мини-карты
    vec4 pixel_color = texture(TEXTURE, UV);
    
    // Если пиксель находится дальше, чем радиус круга (0.5), делаем его невидимым
    if (dist > 0.5) {
        pixel_color.a = 0.0;
    }
    
    COLOR = pixel_color;
}"

